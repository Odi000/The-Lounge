<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/html-head')  %>
</head>

<body>
  <h1><%= title  %></h1>
  <hr>
  <form action="create-post" method="post">
    <label for="title">Title:</label>
    <br>
    <input name="title" id="title" type="text">
    <br>
    <label for="Content" style="float: top;" >Content:</label>
    <br>
    <textarea maxlength="999" name="content" id="content"></textarea>
    <br>
    <button>Submit</button>
  </form>
</body>

</html>