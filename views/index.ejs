<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/html-head')  %>
</head>

<body>
  <h1>Home Page</h1>
  <hr>
  <% if(locals.currentUser) {%>
  <h3>You are logged in as <i style="background-color:black;color: white;padding: 3px 6px;border-radius: 3px;"><%= currentUser.username %></i></h3>
  <br>
  <a href="sign-out">Sign out</a>
  <% } else { %>
  <a href="/sign-up">Sign Up</a>
  <br>
  <a href="/log-in">Log In</a>
  <% } %>
</body>

</html>